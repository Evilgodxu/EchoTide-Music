<?xml version="1.0" encoding="utf-8"?>
<paths>
    <external-files-path name="downloads" path="Download/" />
    <external-files-path name="logs" path="logs/" />
    <!-- 设备音频报告：每次分享重新生成的一次性产物，落在 cacheDir 供分享，不参与任何持久数据 -->
    <cache-path name="reports" path="reports/" />
    <!-- 分享本地曲目：曲库分散在公共存储与可移动卷各处，逐个路径枚举不现实；
         根路径只扩大可解析范围，实际授权仍由分享时给出的单个 URI 决定 -->
    <root-path name="shared_audio" path="." />
</paths>
