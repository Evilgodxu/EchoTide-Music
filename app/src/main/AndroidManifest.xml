<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 全部文件访问 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- 音乐访问：读取本地音乐文件 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- 读取本地封面候选图片：仅从最近图片里挑一张作为封面。
         Android 14 起用户可只授权部分图片，须一并声明该细分权限，
         否则用户选择「仅选中的照片」后应用读不到任何候选图 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- 蓝牙音频设备：读取已连接设备的远端名称（Android 12+ 为运行时权限） -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 音乐播放器声明 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- USB 直出期间置为「仅闹钟」档位，挡掉通知与铃声（不压媒体流）；须用户在系统设置中单独授予免打扰访问权 -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 熄屏后台播放保活：ExoPlayer 熄屏期间持有的 CPU 唤醒锁与 WLAN 锁均要求该权限 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 申请电池优化白名单：免 Doze 的唤醒锁屏蔽与网络限流，长时间熄屏播放不被中断 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 在线音乐搜索与歌词获取 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 更新通知（Android 13+ 需运行时授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内更新：拉起系统安装器安装已下载的更新包 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 设为默认来电铃声/闹钟铃声：写入系统设置，需用户在系统设置中单独授权 -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- USB 独占直出：自接管 USB 音频接口，需 USB 主机能力。
         声明为非必需——不支持主机模式或未接解码器的设备照常可用，直出只是其上的可选一路 -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:largeHeap="true"
        android:appCategory="audio"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:configChanges="locale|layoutDirection|orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 作为音乐播放器可打开与接收音频文件 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <!-- 可接收外部分享/打开的代理音源文件（JSON/JS/文本） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/javascript" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/javascript" />
            </intent-filter>
        </activity>

        <!-- USB 接入的接管入口：无界面，存在的唯一目的是让系统在插入音频类 USB 设备时弹出
             「用哪个应用打开」的选择框——系统只对**有应用认领**的设备弹窗，没有这条声明就什么都不会发生。
             exported 是该机制的既定形态（弹窗由系统发起、选中后由系统启动本活动）；
             范围由 usb_device_filter 限到音频类，故不会在插 U 盘、键鼠时来打扰。

             默认停用：弹窗换来的授权只有 USB 独占接管要用，故该入口由独占开关启停，开关关着时插入
             设备不该有任何弹窗（见 UsbAttachEntry / App 启动时的镜像） -->
        <activity
            android:name=".service.UsbAttachActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!-- 音乐播放前台服务：媒体会话控制通知栏/锁屏。
             须 exported 才能被系统媒体会话框架与外部控制器绑定；无权限保护是
             MediaSessionService 的既定形态——会话只暴露播放控制，不接受任意指令 -->
        <service
            android:name=".service.MusicPlaybackService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- APK 安装文件提供者 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
