<?xml version="1.0" encoding="utf-8"?>
<!--
  USB 接入过滤：只声明音频类（class 1）。

  系统按「设备类 **或** 任一接口类」匹配（AOSP `DeviceFilter.matches` 先比设备描述符再逐个比接口），
  故解码器把类别声明在接口上的情况同样命中——USB 音频设备普遍是这种形态（设备类 0、接口类 1），
  只比设备类会漏掉绝大多数。

  只声明音频类而不放行全部设备：过滤越窄，插 U 盘、键鼠、手机时系统就越不会拿选择弹窗来打扰。
-->
<resources>
    <usb-device class="1" />
</resources>
